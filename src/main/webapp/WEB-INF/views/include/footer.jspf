<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
</main>
<%@ include file="auth-modal.jspf" %>
<footer class="site-footer">
    <div class="inner">
        <div class="footer-brand">
            <strong>Oneday<span class="brand-accent">Class</span></strong>
            <p>취향에 맞는 원데이 클래스를 더 빠르고 편하게 탐색하고 예약하는 크리에이티브 클래스 플랫폼</p>
            <p>&copy; 2026 OnedayClass. Design copyright belongs to seulgae.</p>
        </div>
        <div class="footer-links">
            <a href="<c:url value='/classes' />">전체 클래스</a>
            <a href="<c:url value='/reviews' />">수강생 후기</a>
            <a href="<c:url value='/notices' />">공지사항</a>
            <a href="<c:url value='/qna' />">고객문의 QnA</a>
            <a href="<c:url value='/requests' />">클래스 개설요청</a>
        </div>
    </div>
</footer>
<script>
    (function() {
        var path = window.location.pathname;
        document.querySelectorAll('.site-header .nav a').forEach(function(link) {
            var href = link.getAttribute('href');
            if (href && href !== '/' && path.indexOf(href) === 0) {
                link.classList.add('is-active');
            }
        });
    })();
</script>
</body>
</html>
