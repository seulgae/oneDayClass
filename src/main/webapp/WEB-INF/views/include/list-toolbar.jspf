<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%--@elvariable id="toolbarTitle" type="java.lang.String"--%>
<%--@elvariable id="toolbarAction" type="java.lang.String"--%>
<%--@elvariable id="toolbarScope" type="java.lang.String"--%>
<%--@elvariable id="toolbarButtonHref" type="java.lang.String"--%>
<%--@elvariable id="toolbarButtonLabel" type="java.lang.String"--%>
<%--@elvariable id="selectedKeyField" type="java.lang.String"--%>
<%--@elvariable id="keyword" type="java.lang.String"--%>
<%--@elvariable id="selectedOnOff" type="java.lang.String"--%>
<div class="list-ribbon">
    <div class="list-ribbon-title">
        <h2><i class="ri-layout-grid-line" style="color:var(--primary); margin-right:6px;"></i>${toolbarTitle}</h2>
    </div>
    <form class="search-ribbon" method="get" action="${toolbarAction}">
        <span class="search-ribbon-label"><i class="ri-filter-3-line"></i> 검색 필터</span>
        <c:choose>
            <c:when test="${toolbarScope eq 'class'}">
                <select name="keyField">
                    <option value="cTitle" ${selectedKeyField eq 'cTitle' ? 'selected' : ''}>제목</option>
                    <option value="cCategory" ${selectedKeyField eq 'cCategory' ? 'selected' : ''}>카테고리</option>
                </select>
                <select name="onoff">
                    <option value="" ${empty selectedOnOff ? 'selected' : ''}>온/오프라인 전체</option>
                    <option value="N" ${selectedOnOff eq 'N' ? 'selected' : ''}>온라인 클래스</option>
                    <option value="Y" ${selectedOnOff eq 'Y' ? 'selected' : ''}>오프라인 클래스</option>
                </select>
                <input type="text" name="keyword" value="${keyword}" maxlength="50" placeholder="관심 있는 클래스나 카테고리를 검색해보세요">
            </c:when>
            <c:when test="${toolbarScope eq 'qna'}">
                <select name="keyField">
                    <option value="qTitle" ${selectedKeyField eq 'qTitle' ? 'selected' : ''}>제목</option>
                    <option value="qUid" ${selectedKeyField eq 'qUid' ? 'selected' : ''}>작성자</option>
                    <option value="qCategory" ${selectedKeyField eq 'qCategory' ? 'selected' : ''}>분류</option>
                    <option value="cTitle" ${selectedKeyField eq 'cTitle' ? 'selected' : ''}>클래스</option>
                    <option value="qContent" ${selectedKeyField eq 'qContent' ? 'selected' : ''}>내용</option>
                </select>
                <input type="text" name="keyword" value="${keyword}" maxlength="50" placeholder="궁금한 문의 키워드를 입력해 주세요">
            </c:when>
            <c:when test="${toolbarScope eq 'request'}">
                <select name="keyField">
                    <option value="reqTitle" ${selectedKeyField eq 'reqTitle' ? 'selected' : ''}>제목</option>
                    <option value="reqUid" ${selectedKeyField eq 'reqUid' ? 'selected' : ''}>작성자</option>
                    <option value="reqContent" ${selectedKeyField eq 'reqContent' ? 'selected' : ''}>내용</option>
                </select>
                <input type="text" name="keyword" value="${keyword}" maxlength="50" placeholder="요청 게시글 검색어를 입력해 주세요">
            </c:when>
            <c:otherwise>
                <select name="keyField">
                    <option value="rTitle" ${selectedKeyField eq 'rTitle' ? 'selected' : ''}>제목</option>
                    <option value="rUid" ${selectedKeyField eq 'rUid' ? 'selected' : ''}>작성자</option>
                    <option value="rContent" ${selectedKeyField eq 'rContent' ? 'selected' : ''}>내용</option>
                </select>
                <input type="text" name="keyword" value="${keyword}" maxlength="50" placeholder="후기 키워드를 입력해 주세요">
            </c:otherwise>
        </c:choose>
        <button type="submit"><i class="ri-search-line"></i> 검색</button>
    </form>
    <c:if test="${not empty toolbarButtonHref and not empty toolbarButtonLabel}">
        <a class="btn" href="${toolbarButtonHref}"><i class="ri-add-circle-line"></i> ${toolbarButtonLabel}</a>
    </c:if>
</div>
